# Anthropic Claude API キー（https://console.anthropic.com/ で取得）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# 使用するモデル（未設定の場合は claude-opus-4-8）
# ANTHROPIC_MODEL=claude-opus-4-8

# 返信までの待ち時間（秒）。未設定なら30秒。
# 送り終わってから、この秒数が経過するとまとめて1回返信します。
# 例：900 にすると15分後に返信。（変更後は再デプロイが必要）
# NEXT_PUBLIC_REPLY_DELAY_SEC=30

# ──────────────────────────────────────────────
# SNS 自動投稿（Instagram / Threads）の設定
# 詳しい取得手順は DEPLOY.md の「SNS自動投稿の設定」を参照
# ──────────────────────────────────────────────

# Vercel Cron からの呼び出しを守る合言葉（長いランダム文字列。Vercel の環境変数にも同じ値を設定）
CRON_SECRET=

# 承認用の Google スプレッドシート
# シートの URL の /d/ と /edit の間の文字列
GOOGLE_SHEET_ID=
# Google Cloud で作ったサービスアカウントのメールアドレス（このアドレスにシートを「編集者」で共有する）
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# サービスアカウントの JSON キーにある private_key の値（"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"）
GOOGLE_PRIVATE_KEY=

# Instagram（プロアカウント + Facebook ページ連携が必要）
IG_USER_ID=
IG_ACCESS_TOKEN=

# Threads
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# 1 にすると実際には投稿せず、投稿する内容をログに出すだけ（動作確認用）
# DRY_RUN=1

# 自動生成で 1 回に処理するお題の数（未設定なら 2）
# GENERATE_TOPICS_PER_RUN=2

# 承認ストアの種類。通常は未設定（sheets）。ローカルの動作確認だけなら memory も可
# POST_STORE=sheets
